// use prisma-8

model User {
  id String @id @onCreate(uuid())
  username String @unique
  email String @unique
  password String
  role Role @default(user)
  prolems Problems[]
  problemStatus ProblemStatus[]
}



model Problems {
  id String @id @onCreate(uuid())
  problemStatement String
  description String?
  difficultyLevel difficultyLevel
  memoryLimit Int
  CPUlimit Float
  ProblemStatus ProblemStatus[]
  submit Boolean @default(false)
  submitId String? @onCreate(uuid())
  adminId String
  admin User @relation (fields: [adminId] , references: [id])

  @@unique([problemStatement , adminId])
} 

model  ProblemStatus {
  id String @id @onCreate(uuid())
  problemId String
  problem  Problems @relation(fields: [problemId], references: [id])
  code String
  userId String
  user User @relation(fields: [userId] , references: [id])
  language language
  status Status @default(not_attempted)
}

enum  difficultyLevel {
  // Block keys and attributes
  easy
  medium
  hard
}
enum language {
  // Block keys and attributes
  javascript
  typescript
  go 
  rust 
  python
  ccc
}

enum  Role {
  user
  admin
}

enum  Status {
  // Block keys and attributes
  not_attempted
  submitted
  accepted
}
